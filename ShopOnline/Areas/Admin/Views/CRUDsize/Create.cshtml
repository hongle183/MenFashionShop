@model ShopOnline.Models.Size

@using (Html.BeginForm("Create", "CRUDsize", FormMethod.Post, new { @id = "form-1" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "form-message" })

    <div class="form-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label for="code">Size name</label>
                    <input type="text" class="form-control" name="code" id="code" placeholder="M" />
                    <span class="form-message"></span>
                </div>
            </div>
        </div>
    </div>
}

<script>
    Validator({
        form: '#form-1',
        formGroupSelector: '.form-group',
        errorSelector: '.form-message',
        rules: [
            Validator.isRequired('#code'),
        ],
        onSubmit: function(data, formElement) {
            $.ajax({
                url: formElement.action,
                type: formElement.method,
                dataType: "json",
                data: data,
                success: function(res) {
                    if (res.success) {
                        $("#modal").modal("hide");

                        dataTable.ajax.reload(null, false); // 🔄 reload mà không tải lại trang
                        // Tham số (null, false) => giữ nguyên trang hiện tại (không quay lại trang 1)

                        showToast({
                            type: "success",
                            message: res.msg,
                            language: "en"
                        });
                    } else {
                        showToast({
                            type: "danger",
                            message: res.msg,
                            language: "en"
                        });
                    }
                },
                error: function(err) {
                    console.log(err.responseText);
                },
            });
        }
    });
</script>
