@{
    ViewBag.Title = "Size";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutDashBoard.cshtml";
}

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-7 align-self-center">
            <h4 class="page-title text-truncate text-dark font-weight-medium mb-1">Size manage</h4>
            <div class="d-flex align-items-center">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 p-0">
                        <li class="breadcrumb-item"><a href="~/Admin/DashBoard/Index">Dash board</a></li>
                        <li class="breadcrumb-item active">Size list</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="col-5 align-self-center">
            <div class="customize-input float-right">
                <select class="custom-select custom-select-set form-control bg-white border-0 custom-shadow custom-radius">
                    <option selected>Nov 25</option>
                    <option value="1">Oct 25</option>
                    <option value="2">Sep 25</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <h3 class="text-dark text-uppercase card-title">Size</h3>
    <button class="btn btn-success" id="btnAdd">Add size</button>
    <hr />
    <div class="container-fluid">
        <table class="table">
            <thead class="thead-light">
                <tr>
                    <th scope="col">NO</th>
                    <th>Code</th>
                    <th>Date Update</th>
                    <th width="300px">Feature</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal" tabindex="-1" role="dialog" id="modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="color:#0e1822;">
                <h4 class="modal-title">New size</h4>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmit">Save changes</button>
            </div>
        </div>
    </div>
</div>

<script>
    var dataTable;

    $(document).ready(function () {
        dataTable = $('.table').DataTable($.extend(true, {}, defaultDataTableSettings, {
            ajax: {
                url: '@Url.Action("GetSize", "CRUDsize")',
                type: 'GET',
                dataSrc: 'listSize'
            },
            ordering: { // <= không icon sort default   
                indicators: false,
                handler: false
            },
            columnDefs: [{
                targets: [0, 1, 2],
                columnControl: ['order']
            }],
            columns: [
                {
                    data: null, // auto numbering
                    className: 'text-center',
                    render: function (data, type, row, meta) {
                        return meta.row + 1; // Tạo số thứ tự (NO)
                    }
                },
                { data: 'code', className: 'text-center' },
                {
                    data: 'dateCreate',
                    className: 'text-center',
                    render: function (data, type) {
                        if (!data) return '';
                        // Format "/Date(1739750400000)/" (JSON .NET)
                        var ts = parseInt(data.replace(/\/Date\((\d+)\)\//, '$1'), 10);
                        // Khi DataTables yêu cầu sort/type -> trả numeric (timestamp)
                        if (type === 'sort' || type === 'type') return ts;

                        // Mặc định trả về display format
                        return moment(ts).format('DD/MM/YYYY');
                    }
                },
                {
                    data: 'sizeId',
                    className: 'text-center',
                    orderable: false,
                    render: function (id) {
                        return `
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-outline-warning border-0 edit-btn" name="update" data-id="${id}"><i class="fa-solid fa-paintbrush"></i></button>
                            <button class="btn btn-outline-danger border-0 delete-btn" name="delete" data-id="${id}"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    `;
                    }
                }
            ]
        }));
    });

    // Click button Add
    // Nút tĩnh (submit, open modal)
    $('#btnAdd').click(function (e) {
        e.preventDefault();

        $('.modal-title').html('New size');
        $.ajax({
            url: '@Url.Action("Create", "CRUDsize")',
            type: 'get',
            dataType: 'html',
            success: function (res) {
                $('#modal .modal-body').html(res);
                $('#modal').modal();
            }
        });
    });

    // Click button Edit
    // Nút động (delete/edit trong bảng), được thêm vào DOM sau này (qua AJAX, DataTable, v.v.)
    $(document).on('click', "button[name='update']", function () {
        let idSize = $(this).data('id');
        $('.modal-title').html('Update size');
        $.ajax({
            url: '@Url.Action("Edit", "CRUDsize")',
            type: 'get',
            dataType: 'html',
            data: {
                sizeId: idSize
            },
            success: function (res) {
                $('#modal .modal-body').html(res);
                $('#modal').modal();
            }
        });
    });

    $('#btnSubmit').on('click', function () {
        $("#form-1").submit();
    });

    // Sự kiện click của button Delete
    $(document).on('click', "button[name='delete']", function () {
        let idSize = $(this).data('id');
        if (confirm("Are you sure you want to delete this?!")) {
            $.ajax({
                url: '@Url.Action("Delete", "CRUDsize")',
                type: 'post',
                dataType: 'json',
                data: {
                    sizeId: idSize
                },
                success: function (res) {
                    if (res.success) {
                        dataTable.ajax.reload(null, false); // 🔄 reload mà không tải lại trang
                        // Tham số (null, false) => giữ nguyên trang hiện tại (không quay lại trang 1)

                        showToast({
                            type: "success",
                            message: res.msg,
                            language: "en"
                        });
                    } else {
                        showToast({
                            type: "danger",
                            message: res.msg,
                            language: "en"
                        });
                    }
                },
                error: function (err) {
                    console.log(err.responseText);
                },
            });
        }
    });
</script>